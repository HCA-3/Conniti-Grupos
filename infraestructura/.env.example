# Copie este archivo como .env y reemplace todos los valores change-me.
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DEFAULT_DB=default_db

RABBITMQ_USER=user
RABBITMQ_PASS=change-me-rabbitmq
JWT_SECRET_KEY=change-me-with-at-least-32-characters
INTERNAL_SERVICE_TOKEN=change-me-internal-service-token
ATTENDANCE_SIGNING_KEY=change-me-attendance-signing-key

GRAFANA_ADMIN_USER=coniiti-admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana
GRAFANA_PORT=3000

FRONTEND_URL=http://localhost
PUBLIC_APP_URL=http://localhost
VITE_API_URL=/api
PAYMENT_PROVIDER_MODE=mock

# Datos locales reproducibles. Los crea cada microservicio solo si no existen.
# Cambie estas claves antes de compartir una instancia accesible desde Internet.
DEMO_SEED_ENABLED=true
DEMO_SUPER_ADMIN_EMAIL=admin@coniiti.dev
DEMO_SUPER_ADMIN_PASSWORD=AdminConiiti2026!
DEMO_PARTICIPANT_EMAIL=participante@coniiti.dev
DEMO_PARTICIPANT_PASSWORD=Participante2026!

SMTP_HOST=smtp.example.local
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_NAME=CONIITI

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
PAYPAL_CLIENT_ID=
